MUJOCO_STUDIO_HOST=127.0.0.1
# Three ports: edit Server/ports.json, then restart Hub/VZ/Client.
# Set these variables only for an intentional deployment-specific override.
# MUJOCO_STUDIO_PORT=8765
# MUJOCO_STUDIO_CLIENT_PORT=8766
# VZ_PORT=8877
# Windows 默认自动使用 E:\Mujoco_Project，并在首次启动时创建。
# 如需覆盖默认项目 JSON 目录，请取消下一行注释并修改：
# MUJOCO_STUDIO_DATA=E:\Mujoco_Project

# Optional server-side credential override. The UI stores its key in data/private
# with restricted permissions; it never enters project JSON or the event stream.
LLM_API_KEY=
# Project defaults (editable in the intelligent-agent UI):
LLM_BASE_URL=https://yice.byd.com/ai-gate/v1/chat/completions
LLM_MODEL=DeepSeek-R1-Pro
# 原生 Viewer 回写/轮询统一命令 API；修改 Web 端口时同步修改。
# Viewer callback URL is automatically computed from Hub port on normal launch.
# MUJOCO_STUDIO_URL=http://127.0.0.1:8765

# V2.5.9.1 independent timeout clocks + bounded deferred check-in retry
MUJOCO_STUDIO_SESSION_TTL_HOURS=12
MUJOCO_STUDIO_LEASE_TTL_SECONDS=180
MUJOCO_STUDIO_EDIT_IDLE_CHECKIN_SECONDS=3600

MUJOCO_STUDIO_PENDING_CHECKIN_MAX_RETRY=10
